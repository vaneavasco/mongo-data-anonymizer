{
  "name": "mongo-data-anonymizer",
  "version": "0.3.0",
  "description": "Anonymize specified fields in MongoDB collections and copy them to a target database.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mongo-data-anonymizer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/cli.js",
    "dev": "node --experimental-strip-types --no-warnings src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "mongodb": "^7.7.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "mongodb",
    "anonymizer",
    "anonymization",
    "gdpr",
    "faker",
    "pii"
  ],
  "author": "vanea vasco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaneavasco/mongo-data-anonymizer.git"
  }
}
